            "raw_scalar_links_preserved": {"const": true}
          }
        },
        "discovery": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "ci_test", "pc_alpha", "significance", "mask_type", "recycle_residuals", "tau_min", "tau_max", "tau_max_rule", "contemporaneous_forecast_input", "contemp_collider_rule", "conflict_resolution", "reset_lagged_links", "max_combinations", "max_conds_dim", "max_conds_py", "max_conds_px", "max_conds_px_lagged", "fdr_method"],
          "properties": {
            "method": {"const": "pcmci_plus"}, "ci_test": {"const": "parcorr"}, "pc_alpha": {"const": 0.01},
            "significance": {"const": "analytic"}, "mask_type": {"const": "xyz"}, "recycle_residuals": {"const": false},
            "tau_min": {"const": 0}, "tau_max": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "tau_max_rule": {"const": "floor_half_fps"}, "contemporaneous_forecast_input": {"const": "forbidden"},
            "contemp_collider_rule": {"const": "majority"}, "conflict_resolution": {"const": true},
            "reset_lagged_links": {"const": false}, "max_combinations": {"const": 1},
            "max_conds_dim": {"type": "null"}, "max_conds_py": {"type": "null"}, "max_conds_px": {"type": "null"},
            "max_conds_px_lagged": {"type": "null"}, "fdr_method": {"const": "none"}
          }
