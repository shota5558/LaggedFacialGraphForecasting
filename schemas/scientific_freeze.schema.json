{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lagged-facial-graph-forecasting/scientific-freeze.schema.json",
  "title": "Adopted Primary Facial Motion Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "protocol_status", "authority", "compatibility", "primary", "measurement", "data", "split", "preflight", "artifacts"],
  "properties": {
    "schema_version": {"const": 7},
    "protocol_id": {"const": "primary-2026-09-12-adopted"},
    "protocol_status": {"enum": ["preflight_required", "executable"]},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["specification", "specification_sha256", "adoption_record", "adoption_record_sha256", "recommendation", "recommendation_sha256"],
      "properties": {
        "specification": {"const": "docs/authoritative_primary_experiment_spec_2026-09-12.md"},
        "specification_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "adoption_record": {"const": "docs/adopted_decisions_2026-09-12.md"},
        "adoption_record_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "recommendation": {"const": "docs/primary_experiment_recommendation_2026-09-11.md"},
        "recommendation_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
