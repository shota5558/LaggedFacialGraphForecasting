          "type": "object", "additionalProperties": false,
          "required": ["input", "node_unit", "forecast_projection", "forecast_feature_rule", "raw_scalar_links_preserved"],
          "properties": {
            "input": {"const": "normalized_2d_displacement"},
            "node_unit": {"const": "landmark_coordinate_scalar"},
            "forecast_projection": {"const": "region_block_or"},
