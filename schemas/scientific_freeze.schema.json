          "type": "object", "additionalProperties": false,
          "required": ["method", "intercept", "target_standardization", "input_standardization", "subject_equal_weight", "alpha_grid", "alpha_selection", "alpha_tie_tolerance", "alpha_tie_break", "outer_test_grid_extension"],
