      "properties": {
        "dataset_family": {"const": "NoXi"}, "distribution_policy": {"const": "single_distribution_only"}, "fallback_to_caviares": {"const": "forbidden"}, "conditions": {"const": ["self_speaking", "self_non_speaking"]}, "condition_boundary_exclusion_ms": {"const": 200}, "calibration_seconds": {"const": 10}, "normalization": {"const": "eye_corner_similarity_transform"}, "normalization_reference_distance_min_px": {"const": 20}, "pose_abs_yaw_pitch_max_degrees": {"const": 20}, "missingness": {"const": "no_interpolation_or_resampling"}, "point_valid_subject_fraction": {"const": 0.8}, "point_variance_min": {"const": 1e-12}
