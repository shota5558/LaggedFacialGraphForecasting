        "point_mapping": {"type": "object", "const": {"left_brow": [336, 296, 300], "right_brow": [107, 66, 70], "left_eyelid": [385, 386, 380, 374], "right_eyelid": [158, 159, 153, 145], "left_cheek": [425, 280], "right_cheek": [205, 50], "mouth": [61, 291, 13, 14, 37, 267, 84, 314], "jaw": [176, 152, 400]}}
      }
