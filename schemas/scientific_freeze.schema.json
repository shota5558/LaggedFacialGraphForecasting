      "properties": {
        "dataset_manifest_path": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "dataset_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "extractor_package_version": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "extractor_package_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "model_asset_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "actual_fps": {"anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]}, "actual_cadence": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "actual_subject_group_inventory_path": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "actual_self_history_frames": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}, "outer_split_manifest_path": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "outer_split_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "common_support_manifest_path": {"anyOf": [{"type": "null"}, {"type": "string"}]}, "common_support_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "executable_freeze_path": {"anyOf": [{"type": "null"}, {"type": "string"}]}
      }
