      "required": ["seed", "unit", "pilot_min_subjects", "outer_folds", "outer_fallback_folds", "inner_folds", "pilot_excluded_from_formal", "loso_fallback", "frame_split"],
      "properties": {"seed": {"const": 20260911}, "unit": {"const": "dependency_group"}, "pilot_min_subjects": {"const": 5}, "outer_folds": {"const": 5}, "outer_fallback_folds": {"const": 3}, "inner_folds": {"const": 3}, "pilot_excluded_from_formal": {"const": true}, "loso_fallback": {"const": "forbidden"}, "frame_split": {"const": "forbidden"}}
