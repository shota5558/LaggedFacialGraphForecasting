            "resampling_unit": {"const": "dependency_group"}, "repeat_count": {"const": 100}, "time_order": {"const": "preserved"},
            "duplicate_group": {"const": "independent_series_copy"}, "concatenation": {"const": "forbidden"}, "parent_set_redefinition": {"const": "forbidden"}
