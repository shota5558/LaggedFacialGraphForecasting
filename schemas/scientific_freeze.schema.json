      "required": ["horizon", "conditions", "analysis", "representation", "discovery", "lag", "self_history", "forecaster", "matched_sparsity", "lag_response", "statistics", "discovery_stability"],
      "properties": {
        "horizon": {"const": 1},
        "conditions": {"const": ["self_speaking", "self_non_speaking"]},
        "analysis": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
